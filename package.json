{
  "name": "estadel-test",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "npm run build && node server/index.js",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "npm run test:api && npm run test:e2e",
    "test:api": "node --test \"test/*.test.js\"",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vue-tsc": "^3.2.0"
  }
}
